# Copie para `.env` e preencha. O `.env` real NAO vai para o repositorio.

# ---- Olist Tiny: API v2 (token unico por conta) ----
# Conta B2B (FIBER COMPANY 26.153.970/0010-01) -- a carteira comercial
TINY_TOKEN=
# Conta Matriz (26.153.970/0001-10) -- usada so para os clientes-alvo
# (IGUASPORT/Decathlon, SBF/Centauro, Lorenzo)
TINY_TOKEN_MATRIZ=

# Intervalo minimo entre chamadas a API, em ms (a v2 limita ~60 req/min)
TINY_INTERVALO_MS=650

# ---- Olist Tiny: API v3 (OAuth2) ----
# Opcional. Nao e usado pelo dashboard hoje; fica aqui porque o mesmo .env
# atende outros scripts do ecossistema.
TINY_V3_CLIENT_ID=
TINY_V3_CLIENT_SECRET=
TINY_V3_REDIRECT_URI=http://localhost:3000/callback

# ---- Coleta ----
# Inicio da janela de busca de pedidos (dd/mm/aaaa)
SYNC_DATA_INICIAL=01/01/2025

# ---- Planilha comercial publicada ("PEDIDOS FIBER B2B") ----
# Id de publicacao (Arquivo > Compartilhar > Publicar na web).
# E o trecho depois de /d/e/ na URL do pubhtml.
PLANILHA_PUB_ID=

# ---- Servidor ----
PORT=3110

# Atualizacao automatica dos dados, em minutos (0 desliga).
# Roda dentro do processo do servidor: um unico escritor no SQLite.
SYNC_INTERVALO_MIN=60
